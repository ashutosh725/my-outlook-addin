<?xml version="1.0" encoding="UTF-8" standalone="yes"?>

<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">

  <Id>09fa4124-3eaf-4107-be2a-cadf092d34d6</Id>

  <Version>1.0.0.15</Version>

  <ProviderName>Contoso</ProviderName>

  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="Process Emails"/>

  <Description
    DefaultValue="Process emails and send them to Power Automate."/>

  <IconUrl
    DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

  <HighResolutionIconUrl
    DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

  <SupportUrl
    DefaultValue="https://my-outlook-addin-snowy.vercel.app"/>

  <AppDomains>

    <AppDomain>
      https://my-outlook-addin-snowy.vercel.app
    </AppDomain>

  </AppDomains>

  <Hosts>

    <Host Name="Mailbox"/>

  </Hosts>

  <Requirements>

    <Sets>

      <Set
        Name="Mailbox"
        MinVersion="1.1"/>

    </Sets>

  </Requirements>

  <FormSettings>

    <Form xsi:type="ItemRead">

      <DesktopSettings>

        <SourceLocation
          DefaultValue="https://my-outlook-addin-snowy.vercel.app/taskpane.html"/>

        <RequestedHeight>250</RequestedHeight>

      </DesktopSettings>

    </Form>

  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule
    xsi:type="RuleCollection"
    Mode="Or">

    <Rule
      xsi:type="ItemIs"
      ItemType="Message"
      FormType="Read"/>

  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>


  <!-- ========================================================= -->
  <!-- VERSION OVERRIDES 1.0                                     -->
  <!-- ========================================================= -->

  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>

      <bt:Sets DefaultMinVersion="1.3">

        <bt:Set Name="Mailbox"/>

      </bt:Sets>

    </Requirements>


    <Hosts>

      <Host xsi:type="MailHost">

        <DesktopFormFactor>

          <ExtensionPoint
            xsi:type="MessageReadCommandSurface">

            <OfficeTab id="TabDefault">

              <Group id="MyOutlookAddInGroup">

                <Label resid="GroupLabel"/>

                <Control
                  xsi:type="Button"
                  id="ProcessEmailButton">

                  <Label resid="ProcessEmail.Label"/>

                  <Supertip>

                    <Title resid="ProcessEmail.Label"/>

                    <Description resid="ProcessEmail.Tooltip"/>

                  </Supertip>

                  <Icon>

                    <bt:Image
                      size="16"
                      resid="Icon.16x16"/>

                    <bt:Image
                      size="32"
                      resid="Icon.32x32"/>

                    <bt:Image
                      size="80"
                      resid="Icon.80x80"/>

                  </Icon>

                  <Action xsi:type="ShowTaskpane">

                    <SourceLocation
                      resid="Taskpane.Url"/>

                  </Action>

                </Control>

              </Group>

            </OfficeTab>

          </ExtensionPoint>

        </DesktopFormFactor>

      </Host>

    </Hosts>


    <Resources>

      <bt:Images>

        <bt:Image
          id="Icon.16x16"
          DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

        <bt:Image
          id="Icon.32x32"
          DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

        <bt:Image
          id="Icon.80x80"
          DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

      </bt:Images>


      <bt:Urls>

        <bt:Url
          id="Taskpane.Url"
          DefaultValue="https://my-outlook-addin-snowy.vercel.app/taskpane.html"/>

      </bt:Urls>


      <bt:ShortStrings>

        <bt:String
          id="GroupLabel"
          DefaultValue="Email Actions"/>

        <bt:String
          id="ProcessEmail.Label"
          DefaultValue="Process Email"/>

      </bt:ShortStrings>


      <bt:LongStrings>

        <bt:String
          id="ProcessEmail.Tooltip"
          DefaultValue="Open the email processing task pane."/>

      </bt:LongStrings>

    </Resources>


    <!-- ========================================================= -->
    <!-- VERSION OVERRIDES 1.1                                    -->
    <!-- MOBILE SUPPORT                                           -->
    <!-- ========================================================= -->

    <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">

      <Requirements>

        <bt:Sets DefaultMinVersion="1.5">

          <bt:Set Name="Mailbox"/>

        </bt:Sets>

      </Requirements>


      <Hosts>

        <Host xsi:type="MailHost">


          <!-- ================================================= -->
          <!-- DESKTOP / WEB / NEW OUTLOOK                       -->
          <!-- ================================================= -->

          <DesktopFormFactor>

            <ExtensionPoint
              xsi:type="MessageReadCommandSurface">

              <OfficeTab id="TabDefault">

                <Group id="MyOutlookAddInGroupV11">

                  <Label resid="GroupLabel"/>

                  <Control
                    xsi:type="Button"
                    id="ProcessEmailButtonV11">

                    <Label resid="ProcessEmail.Label"/>

                    <Supertip>

                      <Title resid="ProcessEmail.Label"/>

                      <Description resid="ProcessEmail.Tooltip"/>

                    </Supertip>

                    <Icon>

                      <bt:Image
                        size="16"
                        resid="Icon.16x16"/>

                      <bt:Image
                        size="32"
                        resid="Icon.32x32"/>

                      <bt:Image
                        size="80"
                        resid="Icon.80x80"/>

                    </Icon>

                    <Action xsi:type="ShowTaskpane">

                      <SourceLocation
                        resid="Taskpane.Url"/>

                    </Action>

                  </Control>

                </Group>

              </OfficeTab>

            </ExtensionPoint>

          </DesktopFormFactor>


          <!-- ================================================= -->
          <!-- OUTLOOK MOBILE                                     -->
          <!-- ================================================= -->

          <MobileFormFactor>

            <ExtensionPoint
              xsi:type="MobileMessageReadCommandSurface">

              <Group id="MobileEmailActionsGroup">

                <Label resid="GroupLabel"/>

                <Control
                  xsi:type="MobileButton"
                  id="MobileProcessEmailButton">

                  <Label resid="ProcessEmail.Label"/>

                  <Icon xsi:type="bt:MobileIconList">

                    <!-- 25px -->
                    <bt:Image
                      size="25"
                      scale="1"
                      resid="Icon.25x25"/>

                    <bt:Image
                      size="25"
                      scale="2"
                      resid="Icon.25x25"/>

                    <bt:Image
                      size="25"
                      scale="3"
                      resid="Icon.25x25"/>


                    <!-- 32px -->
                    <bt:Image
                      size="32"
                      scale="1"
                      resid="Icon.32x32Mobile"/>

                    <bt:Image
                      size="32"
                      scale="2"
                      resid="Icon.32x32Mobile"/>

                    <bt:Image
                      size="32"
                      scale="3"
                      resid="Icon.32x32Mobile"/>


                    <!-- 48px -->
                    <bt:Image
                      size="48"
                      scale="1"
                      resid="Icon.48x48"/>

                    <bt:Image
                      size="48"
                      scale="2"
                      resid="Icon.48x48"/>

                    <bt:Image
                      size="48"
                      scale="3"
                      resid="Icon.48x48"/>

                  </Icon>

                  <Action xsi:type="ShowTaskpane">

                    <SourceLocation
                      resid="Taskpane.Url"/>

                  </Action>

                </Control>

              </Group>

            </ExtensionPoint>

          </MobileFormFactor>

        </Host>

      </Hosts>


      <!-- ========================================================= -->
      <!-- RESOURCES                                                 -->
      <!-- ========================================================= -->

      <Resources>

        <bt:Images>

          <!-- Desktop -->
          <bt:Image
            id="Icon.16x16"
            DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

          <bt:Image
            id="Icon.32x32"
            DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

          <bt:Image
            id="Icon.80x80"
            DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>


          <!-- Mobile -->
          <bt:Image
            id="Icon.25x25"
            DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

          <bt:Image
            id="Icon.32x32Mobile"
            DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

          <bt:Image
            id="Icon.48x48"
            DefaultValue="https://my-outlook-addin-snowy.vercel.app/assets/EmailIcon.png"/>

        </bt:Images>


        <bt:Urls>

          <bt:Url
            id="Taskpane.Url"
            DefaultValue="https://my-outlook-addin-snowy.vercel.app/taskpane.html"/>

        </bt:Urls>


        <bt:ShortStrings>

          <bt:String
            id="GroupLabel"
            DefaultValue="Email Actions"/>

          <bt:String
            id="ProcessEmail.Label"
            DefaultValue="Process Email"/>

        </bt:ShortStrings>


        <bt:LongStrings>

          <bt:String
            id="ProcessEmail.Tooltip"
            DefaultValue="Open the email processing task pane."/>

        </bt:LongStrings>

      </Resources>

    </VersionOverrides>

  </VersionOverrides>

</OfficeApp>
